{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/cases.schema.json",
  "title": "测试用例集",
  "description": "cases.json 的结构定义:顶层为对象,cases 字段为用例数组,数组内包含多条用例",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "description": "测试用例数组,每条元素为一条用例对象",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "title", "preconditions", "steps", "expected"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "用例 id,从 1 开始,全文件内唯一"
          },
          "module": {
            "type": "string",
            "minLength": 2,
            "description": "所属模块,按功能点划分,如:用户管理、订单处理、支付流程等"
          },
          "title": {
            "type": "string",
            "minLength": 10,
            "description": "用例标题"
          },
          "preconditions": {
            "type": "array",
            "description": "前置条件,没有则填 []",
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "操作步骤,按执行顺序排列,每条一个动作",
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "expected": {
            "type": "string",
            "minLength": 5,
            "description": "预期结果,整体一段描述"
          }
        }
      }
    }
  }
}